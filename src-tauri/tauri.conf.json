{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NowTree",
  "version": "1.1.8",
  "identifier": "com.nowtree.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NowTree",
        "width": 1000,
        "height": 700,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFGRURCOUJFOTBCOENFMkMKUldRc3pyaVF2cm50SDR0dzJxMW5QWWphOEJqZ0FpTm8rQ0dIWDBNbllPc0owV2NuSDV5UDQrRWMK",
      "endpoints": [
        "https://github.com/z1lyA/NowTree/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
